<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nova OS</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="app-body">
  <main class="content wide">
    <h1>Nova Ordem de Serviço</h1>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <form method="post" action="/orders" class="form-grid">
      <input name="companyName" placeholder="Nome da empresa" required />
      <input name="contactPhone" placeholder="Telefone de contato" required />
      <input name="onSiteContact" placeholder="Contato no local" required />
      <textarea name="problemDescription" placeholder="Descrição do problema" required></textarea>
      <button type="submit">Abrir OS</button>
    </form>
  </main>
</body>
</html>
