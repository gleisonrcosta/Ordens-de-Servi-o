{
  "name": "ordens-servico",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de ordens de serviço com Node.js e MySQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "node --check src/server.js",
    "pm2:start": "pm2 start src/server.js --name ordens-servico",
    "pm2:restart": "pm2 restart ordens-servico",
    "pm2:stop": "pm2 stop ordens-servico",
    "pm2:logs": "pm2 logs ordens-servico"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
